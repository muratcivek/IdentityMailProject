@using IdentityMail.Web.Entities
@model List<PasswordResetRequest>

@{
    ViewData["Title"] = "Şifre Sıfırlama Talepleri";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Admin/PasswordResetRequests.css"
          asp-append-version="true" />
}

<div class="mail-layout">

    <partial name="_MessageSidebar" />

    <main class="content">

        <div class="page-header">

            <div>
                <span class="page-label">
                    YÖNETİM
                </span>

                <h1>Şifre Sıfırlama Talepleri</h1>

                <p>
                    Kullanıcılardan gelen şifre sıfırlama
                    taleplerini yönetin.
                </p>
            </div>

            <div class="request-count">
                <i class="bi bi-key"></i>
                @Model.Count talep
            </div>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert-message success-alert">
                <i class="bi bi-check-circle"></i>
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert-message error-alert">
                <i class="bi bi-exclamation-circle"></i>
                @TempData["Error"]
            </div>
        }


        <div class="requests-container">

            @if (Model.Any())
            {
                foreach (var request in Model)
                {
                    <div class="reset-request-card">

                        <div class="request-user">

                            <div class="request-avatar">
                                @(string.IsNullOrWhiteSpace(request.User?.FirstName)
                                                        ? "?"
                                                        : request.User.FirstName.Substring(0, 1).ToUpper())
                    </div>

                            <div class="request-user-info">

                                <span class="request-label">
                                    KULLANICI
                                </span>

                                <strong>
                                    @request.User?.FirstName
                                    @request.User?.LastName
                                </strong>

                                <span class="request-email">
                                    @request.User?.Email
                                </span>

                            </div>

                        </div>


                        <div class="request-date">

                            <span>Talep Tarihi</span>

                            <strong>
                                <i class="bi bi-calendar3"></i>

                                @request.RequestDate.ToString(
                                                "dd.MM.yyyy HH:mm")
                    </strong>

                </div>


                <div class="request-status">

                    @if (!request.IsCompleted)
                            {
                                <span class="pending-badge">
                                    <i class="bi bi-hourglass-split"></i>
                                    Bekliyor
                                </span>
                            }
                            else
                            {
                                <span class="completed-badge">
                                    <i class="bi bi-check2-circle"></i>
                                    Tamamlandı
                                </span>
                            }

                        </div>


                        <div class="request-action">

                            @if (!request.IsCompleted)
                            {
                                <a asp-controller="Admin"
                                   asp-action="ResetUserPassword"
                                   asp-route-id="@request.Id"
                                   class="reset-button">

                                    <i class="bi bi-key"></i>
                                    Şifreyi Sıfırla

                                </a>
                            }
                            else
                            {
                                <span class="completed-text">
                                    İşlem tamamlandı
                                </span>
                            }

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="bi bi-key"></i>
                    </div>

                    <h3>
                        Şifre sıfırlama talebi yok
                    </h3>

                    <p>
                        Kullanıcılardan gelen talepler
                        burada görüntülenecek.
                    </p>

                </div>
            }

        </div>

    </main>

</div>