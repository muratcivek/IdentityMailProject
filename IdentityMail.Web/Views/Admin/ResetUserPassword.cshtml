@using IdentityMail.Web.DTOs.AdminDtos
@model ResetUserPasswordDto

@{
    ViewData["Title"] = "Şifre Sıfırla";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Admin/ResetUserPassword.css"
          asp-append-version="true" />
}

<div class="mail-layout">

    <partial name="_MessageSidebar" />

    <main class="content">

        <div class="page-header">

            <div>

                <span class="page-label">
                    YÖNETİM
                </span>

                <h1>
                    Şifre Sıfırla
                </h1>

                <p>
                    Kullanıcı için yeni bir geçici şifre belirleyin.
                </p>

            </div>

            <a asp-controller="Admin"
               asp-action="PasswordResetRequests"
               class="back-button">

                <i class="bi bi-arrow-left"></i>

                Taleplere Dön

            </a>

        </div>


        <div class="reset-card">

            <div class="reset-card-header">

                <div class="reset-icon">
                    <i class="bi bi-key"></i>
                </div>

                <div>

                    <span class="card-label">
                        ŞİFRE YÖNETİMİ
                    </span>

                    <h2>
                        Kullanıcı Şifresini Sıfırla
                    </h2>

                    <p>
                        Belirlediğiniz şifre ASP.NET Core Identity
                        üzerinden güvenli şekilde güncellenecektir.
                    </p>

                </div>

            </div>


            <div class="user-box">

                <div class="user-avatar">

                    @{
                        var userFullName =
                        ViewBag.UserFullName?.ToString();

                        if (!string.IsNullOrWhiteSpace(userFullName))
                        {
                            @userFullName.Substring(0, 1).ToUpper()
                        }
                        else
                        {
                            <span>?</span>
                        }
                    }

                </div>

                <div class="user-info">

                    <span>
                        KULLANICI
                    </span>

                    <strong>
                        @(ViewBag.UserFullName ?? "Kullanıcı")
                    </strong>

                    <small>
                        @(ViewBag.UserEmail ?? "")
                    </small>

                </div>

            </div>


            <div class="info-box">

                <i class="bi bi-info-circle"></i>

                <div>

                    <strong>
                        Bilgilendirme
                    </strong>

                    <span>
                        Kullanıcı için geçici bir şifre belirleyin.
                        Kullanıcı bu şifreyle sisteme giriş yapabilecektir.
                    </span>

                </div>

            </div>


            <form asp-controller="Admin"
                  asp-action="ResetUserPassword"
                  method="post"
                  class="reset-form">

                @Html.AntiForgeryToken()

                <input asp-for="RequestId"
                       type="hidden" />


                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <div class="form-group">

                    <label asp-for="NewPassword">
                        Yeni Geçici Şifre
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-lock"></i>

                        <input asp-for="NewPassword"
                               placeholder="Yeni geçici şifre"
                               autocomplete="new-password" />

                    </div>

                    <span asp-validation-for="NewPassword"
                          class="validation-text">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="ConfirmPassword">
                        Yeni Şifre Tekrar
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-shield-lock"></i>

                        <input asp-for="ConfirmPassword"
                               placeholder="Yeni şifreyi tekrar girin"
                               autocomplete="new-password" />

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="validation-text">
                    </span>

                </div>


                <div class="form-actions">

                    <a asp-controller="Admin"
                       asp-action="PasswordResetRequests"
                       class="cancel-button">

                        Vazgeç

                    </a>

                    <button type="submit"
                            class="reset-button">

                        <i class="bi bi-key"></i>

                        Şifreyi Değiştir

                    </button>

                </div>

            </form>

        </div>

    </main>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}