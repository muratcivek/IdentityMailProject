@using IdentityMail.Web.DTOs.UserDtos
@model ForgotPasswordDto

@{
    ViewData["Title"] = "Şifremi Unuttum";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Auth/ForgotPassword.css"
          asp-append-version="true" />
}

<div class="forgot-page">

    <div class="forgot-card">

        <div class="forgot-icon">
            <i class="bi bi-key"></i>
        </div>

        <span class="page-label">
            HESAP KURTARMA
        </span>

        <h1>Şifrenizi mi unuttunuz?</h1>

        <p class="description">
            Hesabınıza ait e-posta adresini girin.
            Şifre sıfırlama talebiniz yöneticiye iletilecektir.
        </p>

        <form asp-controller="Auth"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-group">

                <label asp-for="Email">
                    E-posta Adresi
                </label>

                <div class="input-wrapper">

                    <i class="bi bi-envelope"></i>

                    <input asp-for="Email"
                           placeholder="ornek@mail.com"
                           autocomplete="email" />

                </div>

                <span asp-validation-for="Email"
                      class="validation-text">
                </span>

            </div>

            <button type="submit"
                    class="request-button">

                <i class="bi bi-send"></i>

                Sıfırlama Talebi Gönder

            </button>

        </form>

        <a asp-controller="Auth"
           asp-action="Login"
           class="back-link">

            <i class="bi bi-arrow-left"></i>
            Giriş ekranına dön

        </a>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}