@{
    ViewData["Title"] = "Talep Alındı";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Auth/ForgotPassword.css"
          asp-append-version="true" />
}

<div class="forgot-page">

    <div class="forgot-card">

        <div class="forgot-icon">
            <i class="bi bi-check2-circle"></i>
        </div>

        <span class="page-label">
            TALEP ALINDI
        </span>

        <h1>Talebiniz oluşturuldu</h1>

        <p class="description">
            E-posta adresiniz sistemde kayıtlıysa şifre sıfırlama
            talebiniz yöneticiye iletilmiştir.
        </p>

        <a asp-controller="Auth"
           asp-action="Login"
           class="request-button">

            <i class="bi bi-box-arrow-in-right"></i>
            Giriş Ekranına Dön

        </a>

    </div>

</div>