@using IdentityMail.Web.DTOs.UserDtos
@model LoginDto

@{
    ViewData["Title"] = "Giriş Yap";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Auth/Login.css"
          asp-append-version="true" />
}

<div class="auth-page">

    <div class="auth-card">

        <div class="auth-left">

            <div class="brand-badge">
                <i class="bi bi-envelope-paper"></i>
            </div>

            <h1>Identity Mail</h1>

            <p>
                Kurumsal mesajlaşma hesabınıza güvenli şekilde erişin.
            </p>

            <div class="auth-feature">
                <i class="bi bi-shield-check"></i>

                <div>
                    <strong>Güvenli giriş</strong>
                    <span>Hesabınız ASP.NET Core Identity ile korunur.</span>
                </div>
            </div>

            <div class="auth-feature">
                <i class="bi bi-envelope-check"></i>

                <div>
                    <strong>Mesaj yönetimi</strong>
                    <span>Gelen ve gönderilen mesajlarınızı tek noktadan yönetin.</span>
                </div>
            </div>

            <div class="auth-feature">
                <i class="bi bi-person-lock"></i>

                <div>
                    <strong>Hesap güvenliği</strong>
                    <span>Profil ve şifre işlemlerinizi güvenli şekilde yönetin.</span>
                </div>
            </div>

        </div>

        <div class="auth-right">

            <div class="form-header">

                <h2>Tekrar Hoş Geldiniz</h2>

                <p>
                    Devam etmek için hesabınıza giriş yapın.
                </p>

            </div>

            @if (TempData["RegisterSuccess"] != null)
            {
                <div class="success-message">

                    <i class="bi bi-check-circle-fill"></i>

                    <span>
                        @TempData["RegisterSuccess"]
                    </span>

                </div>
            }

            <form asp-controller="Auth"
                  asp-action="Login"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="form-group">

                    <label asp-for="Email"
                           class="form-label">
                        E-Posta Adresi
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-envelope input-icon"></i>

                        <input asp-for="Email"
                               type="email"
                               class="form-control auth-input"
                               placeholder="ornek@mail.com"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="Email"
                          class="validation-text">
                    </span>

                </div>

                <div class="form-group">

                    <div class="password-label-row">

                        <label asp-for="Password"
                               class="form-label">
                            Şifre
                        </label>

                        <a href="#"
                           class="forgot-password">
                            Şifremi Unuttum
                        </a>

                    </div>

                    <div class="input-wrapper">

                        <i class="bi bi-lock input-icon"></i>

                        <input asp-for="Password"
                               type="password"
                               id="loginPassword"
                               class="form-control auth-input password-input"
                               placeholder="Şifrenizi giriniz"
                               autocomplete="current-password" />

                        <button type="button"
                                class="password-toggle"
                                id="togglePassword">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="validation-text">
                    </span>

                </div>

                <button type="submit"
                        class="login-button">

                    <span>Giriş Yap</span>
                    <i class="bi bi-arrow-right"></i>

                </button>

            </form>

            <div class="forgot-password-area">

                <a asp-controller="Auth"
                   asp-action="ForgotPassword">

                    Şifremi Unuttum

                </a>

            </div>

            <div class="register-link">

                <span>Hesabınız yok mu?</span>

                <a asp-controller="Auth"
                   asp-action="Register">
                    Hesap Oluştur
                </a>

            </div>



        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const togglePassword =
            document.getElementById("togglePassword");

        const password =
            document.getElementById("loginPassword");

        if (togglePassword && password) {

            togglePassword.addEventListener("click", function () {

                const icon = this.querySelector("i");

                if (password.type === "password") {
                    password.type = "text";

                    icon.classList.remove("bi-eye");
                    icon.classList.add("bi-eye-slash");
                }
                else {
                    password.type = "password";

                    icon.classList.remove("bi-eye-slash");
                    icon.classList.add("bi-eye");
                }

            });

        }
    </script>

}