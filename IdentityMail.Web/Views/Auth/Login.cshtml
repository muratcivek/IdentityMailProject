@using IdentityMail.Web.DTOs.UserDtos
@model LoginDto
@{
    ViewData["Title"] = "Giriş Yap";
}

<style>
    body {
        background: #f4f6f9;
    }

    .login-container {
        min-height: 85vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-card {
        width: 100%;
        max-width: 430px;
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        background: #fff;
    }

    .login-header {
        background: #1f3c88;
        color: white;
        border-radius: 15px 15px 0 0;
        padding: 25px;
        text-align: center;
    }

    .login-header h2 {
        margin: 0;
        font-weight: 600;
    }

    .card-body {
        padding: 35px;
    }

    .form-label {
        font-weight: 600;
        color: #555;
    }

    .form-control {
        height: 48px;
        border-radius: 8px;
    }

    .form-control:focus {
        border-color: #1f3c88;
        box-shadow: 0 0 0 .15rem rgba(31,60,136,.2);
    }

    .btn-login {
        width: 100%;
        height: 48px;
        background: #1f3c88;
        color: white;
        font-weight: 600;
        border-radius: 8px;
        transition: .3s;
    }

    .btn-login:hover {
        background: #16316f;
        color: white;
    }

    .login-footer {
        text-align: center;
        margin-top: 20px;
        color: #777;
        font-size: 14px;
    }

    .validation-summary-errors ul {
        margin-bottom: 15px;
    }
</style>

<div class="login-container">
    <div class="card login-card">

        <div class="login-header">
            <h2>Identity Mail</h2>
            <p class="mb-0">Yönetim Paneli Giriş</p>
        </div>

        <div class="card-body">

            <form method="post">

                <div class="mb-3">
                    <label class="form-label">E-Posta Adresi</label>
                    <input type="email"
                           asp-for="Email"
                           class="form-control"
                           placeholder="ornek@mail.com"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Şifre</label>
                    <input type="password"
                           asp-for="Password"
                           class="form-control"
                           placeholder="********"
                           required />
                </div>

                <div class="text-danger mb-3">
                    @Html.ValidationSummary()
                </div>

                <button class="btn btn-login">
                    Giriş Yap
                </button>

            </form>

            <div class="login-footer">
                © @DateTime.Now.Year Identity Mail
            </div>

        </div>

    </div>
</div>
