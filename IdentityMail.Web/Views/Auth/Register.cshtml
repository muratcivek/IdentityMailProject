@using IdentityMail.Web.DTOs.UserDtos
@model RegisterDto

@{
    ViewData["Title"] = "Hesap Oluştur";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Auth/Register.css"
          asp-append-version="true" />
}

<div class="register-page">

    <div class="register-card">

        <div class="register-header">

            <div class="register-icon">
                <i class="bi bi-person-plus"></i>
            </div>

            <h1>Hesap Oluştur</h1>

            <p>
                Identity Mail kullanmaya başlamak için bilgilerinizi girin.
            </p>

        </div>

        <form asp-controller="Auth"
              asp-action="Register"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label asp-for="FirstName"
                           class="form-label">
                        Ad
                    </label>

                    <input asp-for="FirstName"
                           class="form-control register-input"
                           placeholder="Adınızı giriniz" />

                    <span asp-validation-for="FirstName"
                          class="validation-text">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="LastName"
                           class="form-label">
                        Soyad
                    </label>

                    <input asp-for="LastName"
                           class="form-control register-input"
                           placeholder="Soyadınızı giriniz" />

                    <span asp-validation-for="LastName"
                          class="validation-text">
                    </span>

                </div>

            </div>

            <div class="form-group">

                <label asp-for="UserName"
                       class="form-label">
                    Kullanıcı Adı
                </label>

                <input asp-for="UserName"
                       class="form-control register-input"
                       placeholder="Kullanıcı adınızı giriniz" />

                <span asp-validation-for="UserName"
                      class="validation-text">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Email"
                       class="form-label">
                    E-Posta Adresi
                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control register-input"
                       placeholder="ornek@mail.com" />

                <span asp-validation-for="Email"
                      class="validation-text">
                </span>

            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label asp-for="Password"
                           class="form-label">
                        Şifre
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control register-input"
                           placeholder="Şifrenizi giriniz" />

                    <span asp-validation-for="Password"
                          class="validation-text">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="ConfirmPassword"
                           class="form-label">
                        Şifre Tekrar
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control register-input"
                           placeholder="Şifrenizi tekrar giriniz" />

                    <span asp-validation-for="ConfirmPassword"
                          class="validation-text">
                    </span>

                </div>

            </div>

            <div class="password-info">

                <i class="bi bi-info-circle"></i>

                <span>
                    Şifreniz en az 8 karakter, büyük-küçük harf, rakam
                    ve özel karakter içermelidir.
                </span>

            </div>

            <button type="submit"
                    class="register-button">

                <i class="bi bi-person-check"></i>
                Hesap Oluştur

            </button>

        </form>

        <div class="login-link">

            <span>Zaten hesabınız var mı?</span>

            <a asp-controller="Auth"
               asp-action="Login">
                Giriş Yap
            </a>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}