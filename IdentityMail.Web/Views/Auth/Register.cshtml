@using IdentityMail.Web.DTOs.UserDtos
@model RegisterDto
@{
    ViewData["Title"] = "Kullanıcı Kaydı";
}

<style>
    body {
        background: #f4f6f9;
    }

    .register-container {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px 0;
    }

    .register-card {
        width: 100%;
        max-width: 550px;
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        background: #fff;
    }

    .register-header {
        background: #1f3c88;
        color: #fff;
        padding: 25px;
        text-align: center;
        border-radius: 15px 15px 0 0;
    }

        .register-header h2 {
            margin: 0;
            font-weight: 600;
        }

    .card-body {
        padding: 35px;
    }

    .form-label {
        font-weight: 600;
        color: #555;
    }

    .form-control {
        height: 48px;
        border-radius: 8px;
    }

        .form-control:focus {
            border-color: #1f3c88;
            box-shadow: 0 0 0 .15rem rgba(31,60,136,.2);
        }

    .btn-register {
        width: 100%;
        height: 48px;
        background: #1f3c88;
        color: white;
        font-weight: 600;
        border-radius: 8px;
        transition: .3s;
    }

        .btn-register:hover {
            background: #16316f;
            color: #fff;
        }

    .validation-summary-errors ul {
        margin-bottom: 15px;
    }

    .register-footer {
        text-align: center;
        margin-top: 20px;
        color: #777;
        font-size: 14px;
    }
</style>

<div class="register-container">
    <div class="card register-card">

        <div class="register-header">
            <h2>Identity Mail</h2>
            <p class="mb-0">Yeni Kullanıcı Kaydı</p>
        </div>

        <div class="card-body">

            <form asp-action="Register" method="post">

                <div class="mb-3">
                    <label class="form-label">Ad</label>
                    <input type="text"
                           asp-for="FirstName"
                           class="form-control"
                           placeholder="Adınızı giriniz"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Soyad</label>
                    <input type="text"
                           asp-for="LastName"
                           class="form-control"
                           placeholder="Soyadınızı giriniz"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Kullanıcı Adı</label>
                    <input type="text"
                           asp-for="UserName"
                           class="form-control"
                           placeholder="Kullanıcı adınızı giriniz"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">E-Posta Adresi</label>
                    <input type="email"
                           asp-for="Email"
                           class="form-control"
                           placeholder="ornek@mail.com"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Şifre</label>
                    <input type="password"
                           asp-for="Password"
                           class="form-control"
                           placeholder="********"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Şifre Tekrarı</label>
                    <input type="password"
                           asp-for="ConfirmPassword"
                           class="form-control"
                           placeholder="********"
                           required />
                </div>

                <div class="text-danger mb-3">
                    @Html.ValidationSummary()
                </div>

                <button type="submit" class="btn btn-register">
                    Kayıt Ol
                </button>

            </form>

            <div class="register-footer">
                © @DateTime.Now.Year Identity Mail
            </div>

        </div>

    </div>
</div>
