@model UserMessage

@{
    ViewData["Title"] = "Mesaj Detayı";
}

<style>

    body {
        background: linear-gradient(135deg,#eef4fb,#f8fafc);
    }

    .mail-card {
        max-width: 950px;
        margin: 45px auto;
        background: #fff;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(0,0,0,.08);
    }

    .mail-header {
        background: linear-gradient(135deg,#2563eb,#1e3a8a);
        color: white;
        padding: 40px;
    }

        .mail-header h2 {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .mail-header p {
            margin: 0;
            opacity: .9;
        }

    .mail-info {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
        gap: 20px;
        padding: 30px;
        background: #f8fafc;
        border-bottom: 1px solid #e9ecef;
    }

    .info-card {
        background: white;
        border-radius: 15px;
        padding: 18px;
        box-shadow: 0 3px 10px rgba(0,0,0,.05);
    }

        .info-card small {
            display: block;
            color: #6c757d;
            margin-bottom: 6px;
            font-size: 13px;
        }

        .info-card strong {
            color: #212529;
            font-size: 16px;
        }

    .message-section {
        padding: 35px;
    }

    .message-title {
        font-size: 22px;
        font-weight: 700;
        color: #1e3a8a;
        margin-bottom: 20px;
    }

    .message-content {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 30px;
        min-height: 280px;
        white-space: pre-wrap;
        word-break: break-word;
        line-height: 1.9;
        font-size: 16px;
        color: #374151;
        text-align: left;
        display: block;
    }

    .status-area {
        margin-top: 25px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .mail-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 35px;
        border-top: 1px solid #ececec;
        background: #fafafa;
    }

    .btn {
        border-radius: 12px;
        padding: 11px 24px;
        font-weight: 600;
    }

</style>

<div class="mail-card">

    <div class="mail-header">

        <h2>
            📧 @Model.Subject
        </h2>

        <p>
            Mesaj Detayı
        </p>

    </div>

    <div class="mail-info">

        <div class="info-card">

            <small>👤 Gönderen</small>

            <strong>
                @Model.Sender.FirstName @Model.Sender.LastName
            </strong>

        </div>

        <div class="info-card">

            <small>📥 Alıcı</small>

            <strong>
                @Model.Receiver.FirstName @Model.Receiver.LastName
            </strong>

        </div>

        <div class="info-card">

            <small>🕒 Gönderim Tarihi</small>

            <strong>
                @Model.SendDate.ToString("dd.MM.yyyy HH:mm")
            </strong>

        </div>

    </div>

    <div class="message-section">

        <div class="message-title">
            📝 Mesaj İçeriği
        </div>

        <div class="message-content">@Model.Body</div>

        <div class="status-area">

            @if (Model.IsRead)
            {
                <span class="badge bg-success fs-6">
                    ✓ Okundu
                </span>
            }
            else
            {
                <span class="badge bg-primary fs-6">
                    📩 Okunmadı
                </span>
            }

            @if (Model.IsImportant)
            {
                <span class="badge bg-warning text-dark fs-6">
                    ⭐ Önemli Mesaj
                </span>
            }

        </div>

    </div>

    <div class="mail-footer">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Gelen Kutusuna Dön
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-danger"
           onclick="return confirm('Bu mesajı silmek istediğinize emin misiniz?')">
            🗑 Mesajı Sil
        </a>

    </div>

</div>