@using IdentityMail.Web.Entities
@model UserMessage

@{
    ViewData["Title"] = "Mesaj Detayı";
    var isSender = ViewBag.IsSender != null && (bool)ViewBag.IsSender;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Message/Detail.css"
          asp-append-version="true" />
}

<div class="mail-layout">

    <partial name="_MessageSidebar" />

    <main class="content">

        <div class="page-header">

            <div>
                <span class="page-label">
                    MESAJ DETAYI
                </span>

                <h1>@Model.Subject</h1>

                <p>
                    Mesaj bilgilerini ve içeriğini görüntüleyin.
                </p>
            </div>

            <a asp-action="@(isSender ? "Sent" : "Index")"
               class="back-button">

                <i class="bi bi-arrow-left"></i>

                @(isSender
                                ? "Gönderilenlere Dön"
                                : "Gelen Kutusuna Dön")

            </a>

        </div>


        <div class="detail-card">

            <div class="sender-area">

                <div class="sender-avatar">

                    @(Model.Sender?.FirstName?.Substring(0, 1).ToUpper() ?? "?")

                </div>

                <div class="sender-info">

                    <span>GÖNDEREN</span>

                    <strong>
                        @(Model.Sender == null
                                                ? "Bilinmeyen Kullanıcı"
                                                : $"{Model.Sender.FirstName} {Model.Sender.LastName}")
                    </strong>

                    <small>@Model.Sender?.Email</small>

                </div>

                <div class="date">

                    <i class="bi bi-calendar3"></i>

                    @Model.SendDate.ToString("dd.MM.yyyy HH:mm")

                </div>

            </div>


            <div class="properties">

                <div class="property">

                    <span>Alıcı</span>

                    <strong>
                        @(Model.Receiver == null
                                                ? "Bilinmeyen Kullanıcı"
                                                : $"{Model.Receiver.FirstName} {Model.Receiver.LastName}")
                    </strong>

                </div>

                <div class="property">

                    <span>Kategori</span>
                    <strong>@Model.Category</strong>

                </div>

                <div class="property">

                    <span>Okunma Durumu</span>

                    @if (Model.IsRead)
                    {
                        <strong class="read-status">
                            <i class="bi bi-check2-all"></i>
                            Okundu
                        </strong>
                    }
                    else
                    {
                        <strong class="unread-status">
                            <i class="bi bi-envelope"></i>
                            Okunmadı
                        </strong>
                    }

                </div>

            </div>


            <div class="message-body">
                @Model.Body
            </div>


            @if (!isSender)
            {
                <div class="detail-actions">

                    <a asp-action="Reply"
                       asp-route-id="@Model.Id"
                       class="reply-button">

                        <i class="bi bi-reply-fill"></i>
                        Yanıtla

                    </a>

                    <form asp-action="ToggleImportant"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="important-button">

                            <i class="bi @(Model.IsImportant ? "bi-star-fill" : "bi-star")"></i>

                            @(Model.IsImportant
                                                    ? "Önemliden Çıkar"
                                                    : "Önemli Olarak İşaretle")

                    </button>

                    </form>


                    <a asp-controller="Message"
                       asp-action="Report"
                       asp-route-id="@Model.Id"
                       class="report-button">

                        <i class="bi bi-flag"></i>
                        Şikayet Et

                    </a>

                    <form asp-controller="Message"
                          asp-action="MoveToTrash"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="trash-button"
                                onclick="return confirm('Bu mesaj çöp kutusuna taşınsın mı?');">

                            <i class="bi bi-trash3"></i>
                            Çöp Kutusuna Taşı

                        </button>

                    </form>

                </div>
                        }

        </div>

    </main>

</div>