@using IdentityMail.Web.Entities
@using IdentityMail.Web.DTOs.UserMessageDtos

@model InboxViewModel

@{
    ViewData["Title"] = "Gelen Kutusu";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Message/Index.css"
          asp-append-version="true" />
}

<div class="mail-layout">

    <partial name="_MessageSidebar" />

    <main class="content">

        <!-- HEADER -->
        <div class="page-header">

            <div class="page-heading">

                <span class="page-label">
                    MESAJLAR
                </span>

                <h1>Gelen Kutusu</h1>

                <p>
                    Mesajlarınızı görüntüleyin, arayın ve filtreleyin.
                </p>

            </div>

        </div>


        <!-- MODERN FILTER PANEL -->
        <form asp-controller="Message"
              asp-action="Index"
              method="get"
              class="filter-card">

            <div class="filter-card-header">

                <div class="filter-card-title">

                    <div class="filter-title-icon">
                        <i class="bi bi-funnel"></i>
                    </div>

                    <div>
                        <h3>Mesajları Filtrele</h3>

                        <p>
                            Arama ve filtre seçeneklerini birlikte kullanabilirsiniz.
                        </p>
                    </div>

                </div>


                <a asp-controller="Message"
                   asp-action="Index"
                   class="reset-filter">

                    <i class="bi bi-arrow-counterclockwise"></i>

                    Filtreleri Temizle

                </a>

            </div>


            <!-- SEARCH -->
            <div class="main-search-row">

                <div class="main-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           autocomplete="off"
                           placeholder="Gönderen adı veya mesaj konusu ile ara..." />

                </div>


                <button type="submit"
                        class="search-submit">

                    <i class="bi bi-search"></i>

                    Ara

                </button>

            </div>


            <!-- FILTER GRID -->
            <div class="filter-grid">

                <!-- START DATE -->
                <div class="filter-control">

                    <label>
                        <i class="bi bi-calendar3"></i>
                        Başlangıç Tarihi
                    </label>

                    <input type="date"
                           name="startDate"
                           value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />

                </div>


                <!-- END DATE -->
                <div class="filter-control">

                    <label>
                        <i class="bi bi-calendar-check"></i>
                        Bitiş Tarihi
                    </label>

                    <input type="date"
                           name="endDate"
                           value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />

                </div>


                <!-- CATEGORY -->
                <div class="filter-control">

                    <label>
                        <i class="bi bi-tag"></i>
                        Kategori
                    </label>

                    <select name="category">

                        <option value="">
                            Tüm Kategoriler
                        </option>

                        @foreach (MessageCategory category
                                                in Enum.GetValues(typeof(MessageCategory)))
                        {
                            if (Model.Category == category)
                            {
                                <option value="@category" selected>
                                    @category
                                </option>
                            }
                            else
                            {
                                <option value="@category">
                                    @category
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- READ STATUS -->
                <div class="filter-control">

                    <label>
                        <i class="bi bi-envelope-check"></i>
                        Okunma Durumu
                    </label>

                    <select name="readStatus">

                        @if (string.IsNullOrWhiteSpace(Model.ReadStatus))
                        {
                            <option value="" selected>
                                Tüm Mesajlar
                            </option>
                        }
                        else
                        {
                            <option value="">
                                Tüm Mesajlar
                            </option>
                        }

                        @if (Model.ReadStatus == "unread")
                        {
                            <option value="unread" selected>
                                Okunmayan
                            </option>
                        }
                        else
                        {
                            <option value="unread">
                                Okunmayan
                            </option>
                        }

                        @if (Model.ReadStatus == "read")
                        {
                            <option value="read" selected>
                                Okunan
                            </option>
                        }
                        else
                        {
                            <option value="read">
                                Okunan
                            </option>
                        }

                    </select>

                </div>


                <!-- SORT -->
                <div class="filter-control">

                    <label>
                        <i class="bi bi-sort-down"></i>
                        Sıralama
                    </label>

                    <select name="sort">

                        @if (Model.Sort == "newest")
                        {
                            <option value="newest" selected>
                                En Yeni Önce
                            </option>
                        }
                        else
                        {
                            <option value="newest">
                                En Yeni Önce
                            </option>
                        }

                        @if (Model.Sort == "oldest")
                        {
                            <option value="oldest" selected>
                                En Eski Önce
                            </option>
                        }
                        else
                        {
                            <option value="oldest">
                                En Eski Önce
                            </option>
                        }

                    </select>

                </div>


                <!-- IMPORTANT -->
                <div class="important-control">

                    <label class="important-checkbox">

                        @if (Model.ImportantOnly)
                        {
                            <input type="checkbox"
                                   name="importantOnly"
                                   value="true"
                                   checked />
                        }
                        else
                        {
                            <input type="checkbox"
                                   name="importantOnly"
                                   value="true" />
                        }

                        <span class="custom-check">

                            <i class="bi bi-check"></i>

                        </span>

                        <span class="important-label">

                            <i class="bi bi-star-fill"></i>

                            <span>
                                Sadece önemli mesajlar
                            </span>

                        </span>

                    </label>

                </div>

            </div>


            <!-- FILTER FOOTER -->
            <div class="filter-footer">

                <div class="filter-help">

                    <i class="bi bi-info-circle"></i>

                    Birden fazla filtreyi aynı anda kullanabilirsiniz.

                </div>


                <button type="submit"
                        class="filter-button">

                    <i class="bi bi-funnel-fill"></i>

                    Filtreleri Uygula

                </button>

            </div>

        </form>


        <!-- RESULTS -->
        <div class="result-bar">

            <div class="result-count">

                <div class="result-icon">
                    <i class="bi bi-inbox"></i>
                </div>

                <div>

                    <strong>
                        @Model.TotalCount
                    </strong>

                    <span>
                        mesaj bulundu
                    </span>

                </div>

            </div>


            @if (Model.TotalPages > 0)
            {
                <div class="result-page">

                    <span>
                        Sayfa
                    </span>

                    <strong>
                        @Model.Page
                    </strong>

                    <span>
                        /
                    </span>

                    <strong>
                        @Model.TotalPages
                    </strong>

                </div>
            }

        </div>


        <!-- SUCCESS -->
        @if (TempData["Success"] != null)
        {
            <div class="success-message">

                <i class="bi bi-check-circle-fill"></i>

                <span>
                    @TempData["Success"]
                </span>

            </div>
        }


        <!-- MESSAGE LIST -->
        <div class="message-list">

            @if (Model.Messages != null &&
                        Model.Messages.Any())
            {
                foreach (var item in Model.Messages)
                {
                    <article class="message-card @(item.IsRead ? "" : "unread")">

                        <div class="message-left">

                            <div class="sender-avatar">

                                @if (item.Sender != null &&
                                                        !string.IsNullOrWhiteSpace(item.Sender.FirstName))
                                {
                                    @(item.Sender.FirstName
                                                            .Substring(0, 1)
                                                            .ToUpper())
                                                }
                                else
                                {
                                    <span>?</span>
                                }

                            </div>

                        </div>


                        <div class="message-center">

                            <div class="message-header-line">

                                <div class="sender-area">

                                    <strong class="sender-name">

                                        @if (item.Sender != null)
                                        {
                                            @($"{item.Sender.FirstName} {item.Sender.LastName}")
                                        }
                                        else
                                        {
                                            <span>
                                                Bilinmeyen Kullanıcı
                                            </span>
                                        }

                                    </strong>


                                    @if (!item.IsRead)
                                    {
                                        <span class="new-badge">

                                            <span class="badge-dot"></span>

                                            Yeni

                                        </span>
                                    }


                                    @if (item.IsImportant)
                                    {
                                        <span class="important-badge">

                                            <i class="bi bi-star-fill"></i>

                                            Önemli

                                        </span>
                                    }

                                </div>


                                <div class="message-date">

                                    <i class="bi bi-clock"></i>

                                    @item.SendDate.ToString("dd.MM.yyyy HH:mm")

                                </div>

                            </div>


                            <div class="message-subject">

                                @if (!string.IsNullOrWhiteSpace(item.Subject))
                                {
                                    @item.Subject
                                }
                                else
                                {
                                    <span class="empty-value">
                                        Konu belirtilmemiş
                                    </span>
                                }

                            </div>


                            <div class="message-preview">

                                @if (!string.IsNullOrWhiteSpace(item.Body))
                                {
                                    @(item.Body.Length > 150
                                                            ? item.Body.Substring(0, 150) + "..."
                                                            : item.Body)
                                                }
                                else
                                {
                                    <span class="empty-value">
                                        Mesaj içeriği bulunmuyor.
                                    </span>
                                }

                            </div>


                            <div class="message-footer-line">

                                <div class="message-tags">

                                    <span class="category-badge">

                                        <i class="bi bi-tag"></i>

                                        @item.Category

                                    </span>


                                    @if (item.IsRead)
                                    {
                                        <span class="read-badge">

                                            <i class="bi bi-check2-all"></i>

                                            Okundu

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="unread-badge">

                                            <i class="bi bi-envelope"></i>

                                            Okunmadı

                                        </span>
                                    }

                                </div>


                                <div class="message-actions">

                                    <!-- IMPORTANT -->
                                    <form asp-controller="Message"
                                          asp-action="ToggleImportant"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="action-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="returnUrl"
                                               value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />

                                        <button type="submit"
                                                class="icon-action important-action @(item.IsImportant ? "active" : "")"
                                                title="@(item.IsImportant
                                                                                                    ? "Önemlilerden çıkar"
                                                                                                    : "Önemli olarak işaretle")">

                                    <i class="bi @(item.IsImportant
                                                                                       ? "bi-star-fill"
                                                                                       : "bi-star")"></i>

                                </button>

                                    </form>


                                    <!-- TRASH -->
                                    <form asp-controller="Message"
                                          asp-action="MoveToTrash"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="action-form">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="icon-action trash-action"
                                                title="Çöp kutusuna taşı"
                                                onclick="return confirm('Bu mesaj çöp kutusuna taşınsın mı?');">

                                            <i class="bi bi-trash3"></i>

                                        </button>

                                    </form>


                                    <!-- DETAIL -->
                                    <a asp-controller="Message"
                                       asp-action="Detail"
                                       asp-route-id="@item.Id"
                                       class="message-open-button">

                                        <span>
                                            Mesajı Aç
                                        </span>

                                        <i class="bi bi-arrow-right"></i>

                                    </a>

                                </div>

                            </div>

                        </div>

                    </article>
                        }
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h3>
                        Mesaj bulunamadı
                    </h3>

                    <p>
                        Arama veya filtre kriterlerinize uygun mesaj bulunamadı.
                    </p>

                    <a asp-controller="Message"
                       asp-action="Index"
                       class="empty-button">

                        <i class="bi bi-arrow-counterclockwise"></i>

                        Filtreleri Temizle

                    </a>

                </div>
            }

        </div>


        <!-- PAGINATION -->
        @if (Model.TotalPages > 1)
        {
            <div class="pagination-area">

                <div class="pagination-info">

                    Toplam

                    <strong>
                        @Model.TotalCount
                    </strong>

                    mesaj

                    <span>•</span>

                    Sayfa

                    <strong>
                        @Model.Page
                    </strong>

                    /

                    <strong>
                        @Model.TotalPages
                    </strong>

                </div>


                <div class="pagination-buttons">

                    @if (Model.Page > 1)
                    {
                        <a asp-controller="Message"
                           asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-search="@Model.Search"
                           asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                           asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                           asp-route-category="@Model.Category"
                           asp-route-readStatus="@Model.ReadStatus"
                           asp-route-importantOnly="@Model.ImportantOnly"
                           asp-route-sort="@Model.Sort"
                           class="page-button">

                            <i class="bi bi-chevron-left"></i>

                            Önceki

                        </a>
                    }


                    @{
                        var startPage =
                        Math.Max(1, Model.Page - 2);

                        var endPage =
                        Math.Min(Model.TotalPages, Model.Page + 2);
                    }


                    @for (var i = startPage;
                                    i <= endPage;
                                    i++)
                    {
                        <a asp-controller="Message"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@Model.Search"
                           asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                           asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                           asp-route-category="@Model.Category"
                           asp-route-readStatus="@Model.ReadStatus"
                           asp-route-importantOnly="@Model.ImportantOnly"
                           asp-route-sort="@Model.Sort"
                           class="page-number @(i == Model.Page ? "active" : "")">

                            @i

                        </a>
                    }


                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-controller="Message"
                           asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-search="@Model.Search"
                           asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                           asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                           asp-route-category="@Model.Category"
                           asp-route-readStatus="@Model.ReadStatus"
                           asp-route-importantOnly="@Model.ImportantOnly"
                           asp-route-sort="@Model.Sort"
                           class="page-button">

                            Sonraki

                            <i class="bi bi-chevron-right"></i>

                        </a>
                    }

                </div>

            </div>
        }

    </main>

</div>