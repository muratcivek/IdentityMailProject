@using IdentityMail.Web.DTOs.UserMessageDtos
@using IdentityMail.Web.Entities
@model SendMailDto

@{
    ViewData["Title"] = "Yeni Mesaj";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Message/SendMail.css"
          asp-append-version="true" />
}

<div class="mail-layout">

    <partial name="_MessageSidebar" />

    <main class="content">

        <div class="page-header">

            <div>
                <span class="page-label">MESAJLAR</span>
                <h1>Yeni Mesaj</h1>
                <p>Kayıtlı bir kullanıcıya yeni mesaj gönderin.</p>
            </div>

            <a asp-action="Index"
               class="back-button">

                <i class="bi bi-arrow-left"></i>
                Gelen Kutusu

            </a>

        </div>


        <div class="compose-card">

            <div class="compose-intro">

                <div class="compose-icon">
                    <i class="bi bi-envelope-plus"></i>
                </div>

                <div>
                    <h3>Mesaj Oluştur</h3>
                    <p>
                        Mesaj yalnızca kayıtlı kullanıcılara gönderilebilir.
                    </p>
                </div>

            </div>


            <form asp-action="SendMail"
                  method="post">

                <input asp-for="DraftId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="form-group">

                    <label asp-for="ReceiverMail">
                        Alıcı E-Posta
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-envelope"></i>

                        <input asp-for="ReceiverMail"
                               placeholder="ornek@mail.com" />

                    </div>

                    <span asp-validation-for="ReceiverMail"
                          class="validation-text">
                    </span>

                </div>


                <div class="form-grid">

                    <div class="form-group">

                        <label asp-for="Subject">
                            Konu
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-chat-left-text"></i>

                            <input asp-for="Subject"
                                   placeholder="Mesaj konusu" />

                        </div>

                        <span asp-validation-for="Subject"
                              class="validation-text">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Category">
                            Kategori
                        </label>

                        <select asp-for="Category"
                                asp-items="Html.GetEnumSelectList<MessageCategory>()">
                        </select>

                    </div>

                </div>


                <div class="form-group">

                    <label asp-for="Body">
                        Mesaj İçeriği
                    </label>

                    <textarea asp-for="Body"
                              rows="11"
                              placeholder="Mesajınızı yazınız...">
                    </textarea>

                    <span asp-validation-for="Body"
                          class="validation-text">
                    </span>

                </div>


                <div class="form-actions">

                    <a asp-action="Index"
                       class="cancel-button">
                        Vazgeç
                    </a>

                    <button type="submit"
                            asp-action="SaveDraft"
                            formnovalidate
                            class="draft-button">

                        <i class="bi bi-file-earmark"></i>
                        Taslak Kaydet

                    </button>

                    <button type="submit"
                            asp-action="SendMail"
                            class="send-button">

                        <i class="bi bi-send"></i>
                        Mesajı Gönder

                    </button>

                </div>

            </form>

        </div>

    </main>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}