@model IdentityMail.Web.DTOs.UserMessageDtos.SendMailDto

@{
    ViewData["Title"] = "Yeni Mesaj";
}

<style>

    body {
        background: linear-gradient(135deg,#eef4ff,#f8fafc);
    }

    .compose-card {
        max-width: 900px;
        margin: 45px auto;
        border: none;
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 20px 45px rgba(0,0,0,.08);
    }

    .compose-header {
        background: linear-gradient(135deg,#2563eb,#1e3a8a);
        color: white;
        padding: 35px;
    }

        .compose-header h2 {
            font-weight: 700;
            margin-bottom: 5px;
        }

        .compose-header p {
            opacity: .9;
            margin-bottom: 0;
        }

    .compose-body {
        padding: 35px;
    }

    .info-box {
        background: #eef6ff;
        border-left: 5px solid #2563eb;
        padding: 18px;
        border-radius: 12px;
        margin-bottom: 30px;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 8px;
    }

    .input-group-text {
        border-radius: 12px 0 0 12px;
        background: #f8f9fa;
    }

    .form-control {
        border-radius: 0 12px 12px 0;
        border: 1px solid #dee2e6;
        padding: 12px 15px;
        transition: .25s;
    }

        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 .15rem rgba(37,99,235,.15);
        }

    textarea.form-control {
        border-radius: 12px;
        resize: none;
    }

    .validation-summary-valid {
        display: none;
    }

    .validation-summary-errors {
        border-radius: 12px;
        margin-bottom: 20px;
    }

        .validation-summary-errors ul {
            margin-bottom: 0;
            padding-left: 18px;
        }

    .btn-send {
        background: linear-gradient(135deg,#2563eb,#1d4ed8);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px 28px;
        font-weight: 600;
        transition: .25s;
    }

        .btn-send:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37,99,235,.25);
            color: white;
        }

    .btn-cancel {
        border-radius: 12px;
        padding: 12px 28px;
    }

    .text-danger {
        font-size: .9rem;
    }

</style>

<div class="compose-card">

    <div class="compose-header">

        <h2>
            <i class="bi bi-envelope-plus-fill"></i>
            Yeni Mesaj
        </h2>

        <p>
            Kurumsal posta sisteminiz üzerinden güvenli şekilde mesaj gönderin.
        </p>

    </div>

    <div class="compose-body">

        <div class="info-box">

            <i class="bi bi-info-circle-fill text-primary"></i>

            <strong>Bilgilendirme</strong>

            <br />

            Mesaj yalnızca sistemde kayıtlı kullanıcıların
            e-posta adreslerine gönderilebilir.

        </div>

        <form asp-action="SendMail" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="mb-4">

                <label asp-for="ReceiverMail" class="form-label">
                    Alıcı E-Posta
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-person-fill"></i>
                    </span>

                    <input asp-for="ReceiverMail"
                           class="form-control"
                           placeholder="ornek@mail.com" />

                </div>

                <span asp-validation-for="ReceiverMail"
                      class="text-danger"></span>

            </div>

            <div class="mb-4">

                <label asp-for="Subject"
                       class="form-label">

                    Konu

                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-chat-left-text-fill"></i>
                    </span>

                    <input asp-for="Subject"
                           class="form-control"
                           placeholder="Mesaj konusu" />

                </div>

                <span asp-validation-for="Subject"
                      class="text-danger"></span>

            </div>

            <div class="mb-4">

                <label asp-for="Body"
                       class="form-label">

                    Mesaj İçeriği

                </label>

                <textarea asp-for="Body"
                          rows="10"
                          class="form-control"
                          placeholder="Mesajınızı buraya yazınız..."></textarea>

                <span asp-validation-for="Body"
                      class="text-danger"></span>

            </div>

            <hr />

            <div class="d-flex justify-content-between">

                <a asp-action="Index"
                   class="btn btn-outline-secondary btn-cancel">

                    <i class="bi bi-arrow-left"></i>

                    Gelen Kutusu

                </a>

                <button type="submit"
                        class="btn btn-send">

                    <i class="bi bi-send-fill"></i>

                    Mesajı Gönder

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}