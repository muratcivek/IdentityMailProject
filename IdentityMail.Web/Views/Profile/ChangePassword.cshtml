@using IdentityMail.Web.DTOs.UserDtos
@using IdentityMail.Web.DTOs.UserMessageDtos
@model ChangePasswordDto

@{
    ViewData["Title"] = "Şifre ve Güvenlik";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Profile/ChangePassword.css"
          asp-append-version="true" />
}

<div class="security-page">

    <!-- ÜST BAŞLIK -->
    <div class="security-header">

        <div class="security-header-title">
            <h1>Şifre ve Güvenlik</h1>

            <p>
                Hesabınızın güvenliği için güçlü ve benzersiz bir şifre kullanın.
            </p>
        </div>

        <a asp-controller="Message"
           asp-action="Index"
           class="back-link">

            <i class="bi bi-arrow-left"></i>
            Gelen Kutusuna Dön

        </a>

    </div>


    <div class="security-card">

        <!-- SOL TARAF -->
        <div class="security-sidebar">

            <div class="security-icon">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h3>Hesap Güvenliği</h3>

            <p>
                Şifrenizi düzenli olarak güncelleyerek hesabınızı daha güvenli
                tutabilirsiniz.
            </p>

            <div class="security-divider"></div>

            <div class="security-info-item">

                <div class="info-icon">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div>
                    <strong>Güçlü şifre kullanın</strong>
                    <span>
                        Büyük-küçük harf, sayı ve özel karakter kullanın.
                    </span>
                </div>

            </div>

            <div class="security-info-item">

                <div class="info-icon">
                    <i class="bi bi-eye-slash"></i>
                </div>

                <div>
                    <strong>Şifrenizi paylaşmayın</strong>
                    <span>
                        Şifrenizi başka kullanıcılarla paylaşmayın.
                    </span>
                </div>

            </div>

            <div class="security-info-item">

                <div class="info-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <div>
                    <strong>Düzenli güncelleyin</strong>
                    <span>
                        Güvenliğiniz için şifrenizi belirli aralıklarla değiştirin.
                    </span>
                </div>

            </div>

            <div class="security-divider"></div>

            <a asp-controller="Profile"
               asp-action="Index"
               class="profile-link">

                <i class="bi bi-person"></i>

                <span>
                    Profil Bilgilerine Dön
                </span>

            </a>

        </div>


        <!-- SAĞ TARAF -->
        <div class="security-content">

            <div class="content-header">

                <div>
                    <h2>Şifre Değiştir</h2>

                    <p>
                        Mevcut şifrenizi doğrulayarak yeni şifrenizi oluşturun.
                    </p>
                </div>

                <div class="lock-badge">
                    <i class="bi bi-lock"></i>
                    Güvenli Alan
                </div>

            </div>


            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-message">

                    <div class="success-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>

                    <div>
                        <strong>İşlem başarılı</strong>

                        <span>
                            @TempData["SuccessMessage"]
                        </span>
                    </div>

                </div>
            }


            <form asp-controller="Profile"
                  asp-action="ChangePassword"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- MEVCUT ŞİFRE -->
                <div class="form-group">

                    <label asp-for="CurrentPassword"
                           class="form-label">

                        Mevcut Şifre

                    </label>

                    <div class="password-wrapper">

                        <i class="bi bi-lock input-icon"></i>

                        <input asp-for="CurrentPassword"
                               type="password"
                               id="currentPassword"
                               class="form-control password-input"
                               placeholder="Mevcut şifrenizi giriniz"
                               autocomplete="current-password" />

                        <button type="button"
                                class="password-toggle"
                                data-target="currentPassword"
                                aria-label="Şifreyi göster veya gizle">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="CurrentPassword"
                          class="validation-text">
                    </span>

                </div>


                <!-- YENİ ŞİFRE -->
                <div class="form-group">

                    <label asp-for="NewPassword"
                           class="form-label">

                        Yeni Şifre

                    </label>

                    <div class="password-wrapper">

                        <i class="bi bi-shield-lock input-icon"></i>

                        <input asp-for="NewPassword"
                               type="password"
                               id="newPassword"
                               class="form-control password-input"
                               placeholder="Yeni şifrenizi giriniz"
                               autocomplete="new-password" />

                        <button type="button"
                                class="password-toggle"
                                data-target="newPassword"
                                aria-label="Şifreyi göster veya gizle">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="NewPassword"
                          class="validation-text">
                    </span>

                </div>


                <!-- ŞİFRE TEKRAR -->
                <div class="form-group">

                    <label asp-for="ConfirmNewPassword"
                           class="form-label">

                        Yeni Şifre Tekrar

                    </label>

                    <div class="password-wrapper">

                        <i class="bi bi-shield-check input-icon"></i>

                        <input asp-for="ConfirmNewPassword"
                               type="password"
                               id="confirmPassword"
                               class="form-control password-input"
                               placeholder="Yeni şifrenizi tekrar giriniz"
                               autocomplete="new-password" />

                        <button type="button"
                                class="password-toggle"
                                data-target="confirmPassword"
                                aria-label="Şifreyi göster veya gizle">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="ConfirmNewPassword"
                          class="validation-text">
                    </span>

                </div>


                <!-- BİLGİ -->
                <div class="password-notice">

                    <i class="bi bi-info-circle"></i>

                    <div>
                        <strong>Şifre güvenliği</strong>

                        <span>
                            Yeni şifrenizin tahmin edilmesi zor ve daha önce
                            kullanmadığınız bir şifre olması önerilir.
                        </span>
                    </div>

                </div>


                <!-- BUTONLAR -->
                <div class="security-actions">

                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="btn-cancel">

                        Vazgeç

                    </a>

                    <button type="submit"
                            class="btn-save">

                        <i class="bi bi-shield-check"></i>

                        Şifremi Değiştir

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.querySelectorAll(".password-toggle")
            .forEach(function (button) {

                button.addEventListener("click", function () {

                    const targetId =
                        this.getAttribute("data-target");

                    const input =
                        document.getElementById(targetId);

                    const icon =
                        this.querySelector("i");

                    if (input.type === "password") {

                        input.type = "text";

                        icon.classList.remove("bi-eye");
                        icon.classList.add("bi-eye-slash");

                    }
                    else {

                        input.type = "password";

                        icon.classList.remove("bi-eye-slash");
                        icon.classList.add("bi-eye");

                    }

                });

            });

    </script>

}