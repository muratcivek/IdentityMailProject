@using IdentityMail.Web.DTOs.UserDtos
@model ProfileDto

@{
    ViewData["Title"] = "Profilim";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Profile/Index.css"
          asp-append-version="true" />
}

<div class="profile-page">

    <div class="profile-header">

        <div>
            <h1>Profil Bilgileri</h1>
            <p>
                Kişisel bilgilerinizi ve profil fotoğrafınızı güncelleyebilirsiniz.
            </p>
        </div>

        <a asp-controller="Message"
           asp-action="Index"
           class="back-link">

            <i class="bi bi-arrow-left"></i>
            Gelen Kutusuna Dön

        </a>

    </div>

    <div class="profile-card">

        <div class="profile-card-left">

            <div class="profile-image-wrapper">

                @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                {
                    <img src="@Model.ProfileImageUrl"
                         alt="Profil Fotoğrafı"
                         class="profile-image" />
                }
                else
                {
                    <div class="profile-placeholder">

                        @if (!string.IsNullOrEmpty(Model.FirstName))
                        {
                            @Model.FirstName.Substring(0, 1).ToUpper()
                        }
                        else
                        {
                            <span>U</span>
                        }

                    </div>
                }

            </div>

            <h3>
                @Model.FirstName @Model.LastName
            </h3>

            <span class="profile-status">
                Aktif Kullanıcı
            </span>

            <div class="profile-side-divider"></div>

            <a asp-controller="Profile"
               asp-action="ChangePassword"
               class="security-link">

                <i class="bi bi-shield-lock"></i>

                <span>
                    Şifre ve Güvenlik
                </span>

            </a>

        </div>

        <div class="profile-card-right">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success profile-alert">
                    <i class="bi bi-check-circle me-2"></i>
                    @TempData["Success"]
                </div>
            }

            <form asp-controller="Profile"
                  asp-action="Index"
                  method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="form-section-title">
                    Kişisel Bilgiler
                </div>

                <div class="form-row">

                    <div class="form-group">

                        <label asp-for="FirstName"
                               class="form-label">
                            Ad
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-person input-icon"></i>

                            <input asp-for="FirstName"
                                   class="form-control profile-input"
                                   placeholder="Adınızı giriniz" />

                        </div>

                        <span asp-validation-for="FirstName"
                              class="text-danger validation-text">
                        </span>

                    </div>

                    <div class="form-group">

                        <label asp-for="LastName"
                               class="form-label">
                            Soyad
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-person input-icon"></i>

                            <input asp-for="LastName"
                                   class="form-control profile-input"
                                   placeholder="Soyadınızı giriniz" />

                        </div>

                        <span asp-validation-for="LastName"
                              class="text-danger validation-text">
                        </span>

                    </div>

                </div>

                <div class="form-section-title photo-title">
                    Profil Fotoğrafı
                </div>

                <div class="upload-box">

                    <div class="upload-icon">
                        <i class="bi bi-cloud-arrow-up"></i>
                    </div>

                    <div class="upload-content">

                        <label asp-for="ProfileImage"
                               class="upload-label">
                            Yeni profil fotoğrafı seçin
                        </label>

                        <small>
                            JPG, JPEG, PNG veya WEBP formatı kullanabilirsiniz.
                        </small>

                        <input asp-for="ProfileImage"
                               type="file"
                               class="form-control upload-input"
                               accept=".jpg,.jpeg,.png,.webp" />

                        <span asp-validation-for="ProfileImage"
                              class="text-danger validation-text">
                        </span>

                    </div>

                </div>

                <div class="profile-actions">

                    <a asp-controller="Message"
                       asp-action="Index"
                       class="btn-cancel">

                        Vazgeç

                    </a>

                    <button type="submit"
                            class="btn-save">

                        <i class="bi bi-check2"></i>
                        Değişiklikleri Kaydet

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}